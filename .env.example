# OpenAI API key used by the LLM provider.
OPENAI_API_KEY=

# LangSmith tracing configuration.
# Get your key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=enterprise-nested-langgraph
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional overrides for application configuration.
# Settings loaded from config.yaml are the defaults. Anything below
# overrides them. Use double underscores for nested keys.
# APP_LLM__MODEL=gpt-4.1
# APP_LOGGING__LEVEL=DEBUG
# APP_ENVIRONMENT=production
